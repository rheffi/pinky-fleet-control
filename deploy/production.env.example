# Copy to deploy/production.env and replace every replace_* value.
# Do not commit the resulting production.env file.

APP_NAME="Pinky Fleet Control"
APP_IMAGE_TAG=local
APP_IMAGE_REPOSITORY=pinky-fleet-control-app
WEB_IMAGE_REPOSITORY=pinky-fleet-control-web

APP_KEY=replace_with_generated_app_key
APP_URL=http://replace_with_control_server_ip:8080
LOG_LEVEL=warning

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080

DB_DATABASE=pinky_fleet
DB_USERNAME=pinky_app
DB_PASSWORD=replace_with_random_app_password
MYSQL_ROOT_PASSWORD=replace_with_different_random_root_password

# Fleet map and fixed demo poses. Leave pose values empty until measured.
FLEET_MODE=real
FLEET_AGENT_TOKEN=replace_with_random_agent_token
FLEET_MAP_ID=cbs-map
FLEET_MAP_VERSION=replace_with_current_map_hash
FLEET_MAP_FRAME=map

FLEET_ROBOT_62B2_DOMAIN_ID=40
FLEET_ROBOT_62B2_INITIAL_X=
FLEET_ROBOT_62B2_INITIAL_Y=
FLEET_ROBOT_62B2_INITIAL_YAW=
FLEET_ROBOT_62B2_GOAL_X=
FLEET_ROBOT_62B2_GOAL_Y=
FLEET_ROBOT_62B2_GOAL_YAW=

FLEET_ROBOT_648D_DOMAIN_ID=30
FLEET_ROBOT_648D_INITIAL_X=
FLEET_ROBOT_648D_INITIAL_Y=
FLEET_ROBOT_648D_INITIAL_YAW=
FLEET_ROBOT_648D_GOAL_X=
FLEET_ROBOT_648D_GOAL_Y=
FLEET_ROBOT_648D_GOAL_YAW=

FLEET_ROBOT_EED0_DOMAIN_ID=35
FLEET_ROBOT_EED0_INITIAL_X=
FLEET_ROBOT_EED0_INITIAL_Y=
FLEET_ROBOT_EED0_INITIAL_YAW=
FLEET_ROBOT_EED0_GOAL_X=
FLEET_ROBOT_EED0_GOAL_Y=
FLEET_ROBOT_EED0_GOAL_YAW=
