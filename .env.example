# Copy to .env and replace example passwords before starting services.
APP_NAME="Pinky Fleet Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=debug

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
VITE_BIND_ADDRESS=127.0.0.1
VITE_PORT=5173
VITE_USE_POLLING=true
VITE_APP_NAME="${APP_NAME}"

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pinky_fleet
DB_USERNAME=pinky_app
DB_PASSWORD=replace_with_local_app_password
MYSQL_ROOT_PASSWORD=replace_with_different_local_root_password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
